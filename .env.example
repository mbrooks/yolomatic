GITHUB_USERNAME=mbrooks
GITHUB_TOKEN=ghp_your_token
WEBHOOK_SECRET=replace_me
PI_AGENT_MODEL=kimi-k2.7-code:cloud
PI_AGENT_PROVIDER=ollama
# Optional: override the Ollama endpoint Yeetomatic uses for model requests
# OLLAMA_HOST=http://127.0.0.1:11434
SESSIONS_DIR=./sessions
WORKSPACES_DIR=./workspaces
DEFAULT_BRANCH=main
AUTO_START=true
PORT=6767
# Optional: max worktrees per repo before FIFO/LRU eviction kicks in (default 10)
# MAX_WORKTREES=10
# Optional: eviction strategy when worktree limit is reached — fifo or lru (default lru)
# WORKTREE_EVICTION_STRATEGY=lru
# Optional: if set, enables /yeetomatic/admin and /api/status with Basic Auth
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme
# Optional: GitHub username authorized to send /yeetomatic stop (defaults to ADMIN_USERNAME)
# ADMIN_GITHUB_USERNAME=admin
# Optional: age (ms) before a working session is considered stale (default 4h)
# STALE_THRESHOLD_MS=14400000
# Optional: directory to archive stale sessions (default <sessionsDir>/archive)
# ARCHIVE_DIR=./sessions/archive
# Optional: base URL workers use to reach the Yeetomatic control plane
# YEETOMATIC_WORKER_CONTROL_BASE_URL=http://host.docker.internal:6767
# Optional: docker run --network mode for workers; docker-compose uses container:yeetomatic
# YEETOMATIC_WORKER_DOCKER_NETWORK_MODE=
# Optional: explicit OLLAMA_HOST passed into workers
# YEETOMATIC_WORKER_OLLAMA_HOST=
