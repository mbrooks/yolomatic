GITHUB_USERNAME=mbrooks
GITHUB_TOKEN=ghp_your_token
WEBHOOK_SECRET=replace_me
PI_AGENT_MODEL=kimi-k2.6:cloud
PI_AGENT_PROVIDER=ollama
SESSIONS_DIR=./sessions
WORKSPACES_DIR=./workspaces
DEFAULT_BRANCH=main
AUTO_START=true
PORT=6767
# Optional: if set, enables /tarsadmin and /api/status with Basic Auth
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme

# Optional: threshold in ms after which a working session is considered stale (default: 4h / 14400000)
# STALE_THRESHOLD_MS=14400000

# Optional: directory to archive stale session state/transcripts (default: <SESSIONS_DIR>/archive)
# ARCHIVE_DIR=./sessions/archive
