GITHUB_USERNAME=mbrooks
GITHUB_TOKEN=ghp_your_token
WEBHOOK_SECRET=replace_me
PI_AGENT_MODEL=kimi-k2.7-code:cloud
PI_AGENT_PROVIDER=ollama
# OpenAI platform API key. Required when PI_AGENT_PROVIDER=openai.
# Forwarded to worker containers as OPENAI_API_KEY. Leave blank for ollama.
# OPENAI_API_KEY=sk-...
# Optional: enable debug logging for the control plane (default false)
# DEBUG_LOG=false
# Optional: override the Ollama endpoint Yolomatic uses for model requests
# OLLAMA_HOST=http://127.0.0.1:11434
# Optional: name of the Ollama container the control plane shells into to check sign-in status
# OLLAMA_CONTAINER_NAME=yolomatic-ollama
SESSIONS_DIR=./sessions
WORKSPACES_DIR=./workspaces
DEFAULT_BRANCH=main
AUTO_START=true
PORT=6767
# Optional: max worktrees per repo before FIFO/LRU eviction kicks in (default 10)
# MAX_WORKTREES=10
# Optional: eviction strategy when worktree limit is reached — fifo or lru (default lru)
# WORKTREE_EVICTION_STRATEGY=lru
# Optional: if set, enables /yolomatic/admin and /api/status with Basic Auth
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme
# Optional: GitHub username authorized to send /yolomatic stop (defaults to ADMIN_USERNAME)
# ADMIN_GITHUB_USERNAME=admin
# Optional: age (ms) before a working session is considered stale (default 4h)
# STALE_THRESHOLD_MS=14400000
# Optional: idle time (ms) after which a "working" session with no activity
# is automatically failed (default 1h)
# IDLE_WORKING_FAIL_MS=3600000
# Optional: directory to archive stale sessions (default <sessionsDir>/archive)
# ARCHIVE_DIR=./sessions/archive
# Optional: base URL workers use to reach the Yolomatic control plane
# YOLO_WORKER_CONTROL_BASE_URL=http://host.docker.internal:6767
# Optional: docker run --network mode for workers; docker-compose uses container:yolomatic
# YOLO_WORKER_DOCKER_NETWORK_MODE=
# Optional: explicit OLLAMA_HOST passed into workers
# YOLO_WORKER_OLLAMA_HOST=
# Optional: path to a repository-provided init script the worker runs before
# the agent starts (resolved relative to the workspace; default yolostrap.sh)
# YOLO_WORKER_INIT_SCRIPT=yolostrap.sh
# Optional: set to 1 (or true) to skip the worker init script entirely
# YOLO_WORKER_INIT_SKIP=0
# Optional: wall-clock seconds before the worker init script is killed (default 1800)
# YOLO_WORKER_INIT_TIMEOUT_SECONDS=1800
