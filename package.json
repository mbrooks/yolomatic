{
  "name": "pi-coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "guardrail:test": "npm run test:coverage && npm run build && node ./dist/guardrails.js"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@octokit/rest": "^21.0.0",
    "dotenv": "^17.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
