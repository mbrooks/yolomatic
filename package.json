{
  "name": "pi-coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.admin.json && vite build",
    "build:server": "tsc -p tsconfig.json",
    "build:admin": "tsc -p tsconfig.admin.json && vite build",
    "start": "node dist/index.js",
    "test": "NODE_ENV=development vitest run",
    "test:watch": "vitest",
    "test:coverage": "NODE_ENV=development node ./scripts/run-guardrail-coverage.js",
    "guardrail": "npm run guardrail:test",
    "guardrail:test": "NODE_ENV=development npm test && npm run test:coverage && npm run build && node ./dist/guardrails.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "scheduler": "^0.27.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.6"
  }
}
