{
  "name": "yolomatic",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.admin.json && vite build",
    "build:server": "tsc -p tsconfig.json",
    "build:admin": "tsc -p tsconfig.admin.json && vite build",
    "start": "node dist/index.js",
    "test": "NODE_ENV=development vitest run",
    "test:watch": "vitest",
    "test:coverage": "NODE_ENV=development node ./scripts/run-guardrail-coverage.js",
    "guardrail": "npm run guardrail:test",
    "config:dump": "tsx ./scripts/dump-config.ts",
    "onboarding:reset": "node ./scripts/force-onboarding.js",
    "preflight": "node ./scripts/preflight.js",
    "guardrail:test": "npm run preflight && NODE_ENV=development npm test && npm run test:coverage && npm run build && node ./dist/guardrails.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scheduler": "^0.27.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
